# ============================================================
# Vitis-Tutorials root .gitignore
# ============================================================

# --- Environment, credentials, and tooling ---
.env
.venv/
.claude/
CLAUDE.md

# --- Vitis / Vivado / AI Engine build artifacts ---
# Build output directories (generated by aiecompiler, v++, vivado)
Work/
Work_x86/
.Xil/

# Simulator output directories
x86simulator_output/
aiesimulator_output/
hw_emu/

# Build staging directories (generated by v++ link/package)
_x/
build/
sd_card/
package/

# --- Compiled objects and binaries ---
*.o
*.d
*.a
*.so
*.elf
*.xo
*.xclbin
*.xsa
*.pdi
*.bif
*.ltx
*.xpe

# --- Log and journal files ---
*.log
*.jou
*.str

# --- Waveform and simulation dumps ---
*.vcd
*.wdb
*.wcfg

# --- Vivado / Vitis project files (generated, not source) ---
*.runs/
*.cache/
*.hw/
*.ip_user_files/
*.sim/

# --- Vitis HLS ---
*.csolution/
vivado_hls.app

# --- Crash and temp files ---
.crashReporter/
*.pyc
__pycache__/
.*.sw*

# --- Generated review reports (per-session, not source) ---
Tutorial_Review_Report*.md

# --- Misc stray files that should never be committed ---
*.nfs*
