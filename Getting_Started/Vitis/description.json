{
    "name": "Getting Started with Vitis",
    "description": "getting-started-with-vitis",
    "gui": "false",
    "flow": "versal",

    "platform_allowlist": [ "vck190"],
    "platform_blocklist": [],

    "testinfo": {
        "test_name": "GS_vitis",
        "jobs": [
            {
                "max_memory_MB": 65536,
                "max_time_min": {
                    "vitis_hw_build": 300,
                    "vitis_hw_emu": 120,
                    "vitis_hw_run": 30
                }
            }
        ],
        "targets": [
            "vitis_hw_emu",
            "vitis_hw_build",
            "vitis_hw_run"
        ],
        "category": "canary",
	"make_options": [
            "EMU_CMD=\\\"./launch_hw_emu.sh -run-app post_boot.sh \\\"",
            "EMBEDDED_PACKAGE_OUT=./vitis_dir/pack_out_dir", 
            "EMBEDDED_EXEC_SCRIPT=./post_boot.sh"
	    ],
        "custom_build_target": {
            "all": "all"
        },
        "custom_board_target": "run_test",
        "tasks": {
            "board" : {
                "pre_exec" : ["./env_setup_versal.sh"]
            },
           "build": {
               "pre_exec": ["./env_setup_versal.sh"]
           }
        }
    }
}
