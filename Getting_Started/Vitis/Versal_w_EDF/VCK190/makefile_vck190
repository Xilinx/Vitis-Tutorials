# =============================================================================
# Project Configuration
# =============================================================================
ROOT_DIR    := $(realpath $(dir $(lastword $(MAKEFILE_LIST))))
# AIE sources and system.cfg are copied into vck190_work/ by the top-level
# Makefile's cpSources target before this inner makefile runs.
# HLS kernels and host app are referenced from the PetaLinux sibling tutorial.
PETALINUX_SRC := $(abspath $(ROOT_DIR)/../../../Versal_w_PetaLinux/VCK190)
TARGET ?= hw_emu
MODE := hw_emu

# =============================================================================
# Toolchain Configuration
# =============================================================================

SYSROOT := $(YOCTO_ARTIFACTS)/amd-cortexa72-common_meta-edf-app-sdk/sdk/sysroots/cortexa72-cortexa53-amd-linux/

# =============================================================================
# File Names and Paths
# =============================================================================
PLATFORM ?= ${PLATFORM_REPO_PATHS}/vck190_base/vck190_base.xpfm

LINK_OUT := vck190_$(TARGET).xsa
XCLBIN := vck190.xclbin
AIE_WORK = $(ROOT_DIR)/vck190_work/

# =============================================================================
# QEMU Configuration
# =============================================================================
export QEMU_COMBINED := edf_qemu_images
export COMBINED := combined
export WIC_FILE := edf-platform-disk-image-amd-cortexa72-common.rootfs.wic.qemu-sd
export WIC_PARTITION := $(WIC_FILE):2
export WIC_BOOT_PARTITION := $(WIC_FILE):1

# v++ packager emits a BOOT.bin that bundles bootloader + our design's PDI.
# We swap the prebuilt's BOOT-versal-vck190-multidomain.bin with this one so the
# PLM loads our PL/AIE bitstream during boot rather than the generic prebuilt.
VPP_BOOT_BIN     = $(PKG_DIR)/BOOT.bin
BOOT_BIN_BOARD   = $(QEMU_COMBINED)/$(COMBINED)/BOOT-versal-vck190-multidomain.bin

DISK_IMAGES := amd-cortexa72-common_edf-platform-disk-image
QEMU_IMAGES	:= amd-cortexa72-common_vck190_qemu_prebuilt
YOCTO_QEMU_ARTIFACTS :=

# =============================================================================
# SoC Configuration
# =============================================================================
EMBEDDED_EXEC_SCRIPT := embedded_exec.sh

# =============================================================================
# Build Directories
# =============================================================================
TEMP_DIR := _x.$(TARGET)
BUILD_DIR := build_dir.$(TARGET)
PKG_DIR := package.$(TARGET)
AIE_WORKDIR := ./_aie

# =============================================================================
# Compiler Tools
# =============================================================================
XCXX := v++
XAIE := aiecompiler

ifeq ($(EMU_PS),X86)
CXX := g++
else
CXX := $(XILINX_VITIS)/gnu/aarch64/lin/aarch64-linux/bin/aarch64-linux-gnu-g++
endif

GCC_FLAGS := -Wall -c \
			 -std=c++17 \
			 -Wno-int-to-pointer-cast \
			 --sysroot=$(SYSROOT) \

GCC_INCLUDES := -I$(SYSROOT)/usr/include/xrt \
				-I$(SYSROOT)/usr/include \
				-I./ -I$(PETALINUX_SRC)/Host_srcs/ -I./AIE_Kernel/aie_srcs/ \
				-I${XILINX_VITIS}/aietools/include \
				-I${XILINX_VITIS}/include


GCC_LIB := -Wall -std=c++17 \
		   -L$(SYSROOT)/usr/lib \
		   --sysroot=$(SYSROOT) \
		   -L${XILINX_VITIS}/aietools/lib/aarch64.o \
		   -ladf_api_xrt -lxrt_coreutil -lpthread -lrt -ldl -luuid

ifeq ($(TARGET),$(filter $(TARGET),sw_emu))
ifeq ($(EMU_PS), X86)
       GCC_LIB := -lxrt_coreutil -L${XILINX_VITIS}/aietools/lib/lnx64.o -L${XILINX_XRT}/lib
       GCC_FLAGS := -Wall -c -std=c++17 -Wno-int-to-pointer-cast -I${XILINX_XRT}/include
       GCC_INCLUDES := -I$(PETALINUX_SRC)/Host_srcs/ -I./ -I${XILINX_VITIS}/aietools/include
else
       GCC_LIB := -lxrt_coreutil -L$(SYSROOT)/usr/lib --sysroot=$(SYSROOT) -L${XILINX_VITIS}/aietools/lib/aarch64.o
endif
endif

# =============================================================================
# Source Files
# =============================================================================
GRAPH_SRC := ./AIE_Kernel/aie_srcs/graph.cpp
MM2S_SRC  := $(PETALINUX_SRC)/HLS_Kernels/mm2s.cpp
S2MM_SRC  := $(PETALINUX_SRC)/HLS_Kernels/s2mm.cpp

# =============================================================================
# Build Artifacts
# =============================================================================
GRAPH_XO := libadf.a
MM2S_XO  := mm2s.xo
S2MM_XO  := s2mm.xo
XOS := $(MM2S_XO) $(S2MM_XO) $(GRAPH_XO)

# =============================================================================
# Compiler Flags
# =============================================================================
GRAPH_FLAGS := \
	--nodot-graph=true \
	-log-level=5 \
	-v \
	-include="./AIE_Kernel/aie_srcs/" \
	-include="./AIE_Kernel/data_srcs" \
	-include="./" \
	--output-archive=$(GRAPH_XO)

LINK_FLAGS := --config ./vitis_dir/system.cfg
PKG_FLAGS := --package.defer_aie_run --package.out_dir $(PKG_DIR)

XAIE_FLAGS := \
	-include="${XILINX_VITIS_AIETOOLS}/include" \
	-include="./" \
	-workdir "$(AIE_WORKDIR)"

# Application Configuration
# =============================================================================
HOST_SRC := $(PETALINUX_SRC)/Host_srcs/host.cpp
HOST_SRC_XRT := $(ROOT_DIR)/_aie/ps/c_rts/aie_control_xrt.cpp
EXECUTABLE = ./application

# =============================================================================
# Build Rules
# =============================================================================
.PHONY: all build host integration package emconfig dtbo aiesim_options clean ultraclean help run_emu sd_card run_hw qemu_combined copy_bin insert_image

all: run_emu
sd_card: run_hw

build: $(LINK_OUT)

$(GRAPH_XO): $(GRAPH_SRC)
	@echo "Building AI Engine graph..."
	$(XAIE) $(XAIE_FLAGS) --platform $(PLATFORM) $(GRAPH_FLAGS) $<

$(MM2S_XO): $(MM2S_SRC)
	@echo "Building PL kernel: mm2s..."
	@mkdir -p $(TEMP_DIR)
	$(XCXX) -t $(TARGET) --platform $(PLATFORM) -c -o $@ $< -k mm2s

$(S2MM_XO): $(S2MM_SRC)
	@echo "Building PL kernel: s2mm..."
	@mkdir -p $(TEMP_DIR)
	$(XCXX) -t $(TARGET) --platform $(PLATFORM) -c -o $@ $< -k s2mm

$(LINK_OUT): $(GRAPH_XO) $(MM2S_XO) $(S2MM_XO)
	@echo "Linking kernels..."
	@mkdir -p $(BUILD_DIR)
	$(XCXX) -t $(TARGET) --platform $(PLATFORM) \
		--temp_dir $(TEMP_DIR) -l -o $@ $^ $(LINK_FLAGS)

$(XCLBIN): $(LINK_OUT)
	@echo "Generating XCLBIN..."
	$(XCXX) $(PKG_FLAGS) -s -f $< $(GRAPH_XO) -t $(TARGET) -p -o $@

# emconfig.json describes the platform/board topology to XRT in emulation mode
# (XCL_EMULATION_MODE=hw_emu). The cosim XRT shim in the guest reads it from the
# host application's working directory; we ship it alongside the host exe in
# /media (see insert_image).
emconfig: $(LINK_OUT)
	@echo "Generating emconfig.json from $(LINK_OUT)..."
	emconfigutil --platform $(LINK_OUT) --od . --nd 1

# Compile the auto-generated zocl device-tree overlay so it can be applied at
# runtime via fpgautil.  Without this overlay the booted Linux DT has no
# `zyxclmm_drm` (compatible "xlnx,zocl-versal") node, and zocl never registers
# a /dev node -> XRT throws "No such device with index '0'".
DTC ?= $(shell command -v dtc 2>/dev/null || echo $(XILINX_VIVADO)/bin/dtc)
ZOCL_DTSI := _x/package/updated_zocl.dtsi
ZOCL_DTBO := vck190.dtbo
dtbo: $(ZOCL_DTBO)
$(ZOCL_DTBO):
	@if [ ! -f $(ZOCL_DTSI) ]; then \
		echo "WARNING: $(ZOCL_DTSI) not found; cannot generate zocl overlay."; \
		echo "         The host application will hit 'No such device with index 0' at runtime."; \
	else \
		echo "Compiling zocl overlay $(ZOCL_DTSI) -> $@"; \
		( echo '/dts-v1/; /plugin/;'; cat $(ZOCL_DTSI) ) > $@.dts; \
		$(DTC) -@ -O dtb -o $@ -I dts $@.dts; \
		$(RM) $@.dts; \
	fi

# aiesim_options.txt points launch_hw_emu.sh's AIE simulator backend at the
# absolute path of the AIE compiler workdir, which is where xsim looks for the
# graph/CDO/elfs it needs to cosimulate the AIE side.
AIESIM_OPTIONS := aiesim_options.txt
aiesim_options: $(AIESIM_OPTIONS)
$(AIESIM_OPTIONS):
	@echo "Writing $(AIESIM_OPTIONS) (points AIE simulator at $(ROOT_DIR)/$(AIE_WORKDIR))"
	@rm -f $@
	@echo "AIE_PKG_DIR=$(ROOT_DIR)/$(AIE_WORKDIR)" > $@

integration:
	@echo "Starting integration for target: $(TARGET)"
	$(RM) -rf $(LINK_OUT)
	$(MAKE) build TARGET=$(TARGET)
	@echo "Integration complete for target: $(TARGET)"

package: $(XCLBIN)
	@echo "XCLBIN and PDI generated for target: $(TARGET)"

host: $(EXECUTABLE)

$(EXECUTABLE): $(HOST_SRC)
ifneq ($(EMU_PS), X86)
endif
		$(CXX) $(HOST_SRC) $(GCC_FLAGS) $(GCC_INCLUDES) -o application.o
		$(CXX) $(HOST_SRC_XRT) $(GCC_FLAGS) $(GCC_INCLUDES) -o aie_control_xrt.o
		$(CXX) application.o aie_control_xrt.o $(GCC_LIB) -o $(EXECUTABLE)
	@echo "COMPLETE: Host application created."

run_hw:
	@echo "Preparing hardware run environment..."
	$(MAKE) build TARGET=hw
	$(MAKE) package TARGET=hw
	$(MAKE) dtbo
	$(MAKE) host
	@mkdir -p hw_run/
	@cp -rf ./package.hw/vck190.pdi ./vck190.xclbin ./application $(notdir $(EMBEDDED_EXEC_SCRIPT)) hw_run/
	@if [ -f ./vck190.dtbo ]; then cp ./vck190.dtbo hw_run/; fi
	@echo "Copy hw_run to your board and execute embedded_exec.sh"

qemu_combined:
	@echo "Preparing QEMU combined images..."
	$(RM) -rf ${QEMU_COMBINED}
	@mkdir -p ${QEMU_COMBINED}/${COMBINED}
	@if ls ${YOCTO_ARTIFACTS}/${DISK_IMAGES}/*.wic* >/dev/null 2>&1; then \
		echo "Copying from YOCTO_ARTIFACTS..."; \
		cp -prf ${YOCTO_ARTIFACTS}/${DISK_IMAGES}/* ${QEMU_COMBINED}/${COMBINED}/; \
		cp -prf ${YOCTO_ARTIFACTS}/${QEMU_IMAGES}/* ${QEMU_COMBINED}/${COMBINED}/; \
	elif ls ${YOCTO_QEMU_ARTIFACTS}/*.wic* >/dev/null 2>&1; then \
		echo "Primary source not found, copying from YOCTO_QEMU_ARTIFACTS..."; \
		cp -prf ${YOCTO_QEMU_ARTIFACTS}/* ${QEMU_COMBINED}/${COMBINED}/; \
	else \
		echo "Error: Required WIC files not found in either source directory."; \
		exit 1; \
	fi

# Replace the prebuilt BOOT-versal-vck190-multidomain.bin (which holds only the
# generic bootloader chain) with the BOOT.bin emitted by v++ --package, so the
# PLM boots our design's PDI.  If the packager did not emit BOOT.bin (e.g. due
# to the known 2026.1 lopper/aie_*.dtb tool regression), fall back to the
# prebuilt with a warning so the build can still complete.
copy_bin:
	@if [ -f $(VPP_BOOT_BIN) ]; then \
		echo "Replacing $(BOOT_BIN_BOARD) with locally-built $(VPP_BOOT_BIN)"; \
		$(RM) $(BOOT_BIN_BOARD); \
		cp $(VPP_BOOT_BIN) $(BOOT_BIN_BOARD); \
		echo "Refreshing boot.bin symlink so wic cp + runqemu pick up the new BOOT.bin"; \
		$(RM) $(QEMU_COMBINED)/$(COMBINED)/boot.bin; \
		ln -sf BOOT-versal-vck190-multidomain.bin $(QEMU_COMBINED)/$(COMBINED)/boot.bin; \
	else \
		echo "WARNING: $(VPP_BOOT_BIN) not found; keeping prebuilt $(BOOT_BIN_BOARD)."; \
		echo "         The design PL/AIE PDI will not be loaded during boot."; \
		echo "         This is the expected behaviour while the Vitis 2026.1 lopper"; \
		echo "         tool regression (missing aie_*.dtb -> BOOT.bin) is unresolved."; \
	fi


insert_image:
	@echo "Inserting images into base WIC..."
	@bash -c '\
	unset LD_LIBRARY_PATH; \
	source $(XILINX_VITIS)/data/emulation/qemu/comp/qemu_edf/environment-setup-x86_64-amdedfsdk-linux; \
	echo "Sourced environment"; \
	wic cp --sector-size=512 ./$(QEMU_COMBINED)/$(COMBINED)/boot.bin ./$(QEMU_COMBINED)/$(COMBINED)/$(WIC_BOOT_PARTITION); \
	echo "Copied boot.bin into partition 1 (EFI)"; \
	wic cp --sector-size=512 ./run_app_hw_emu.sh ./$(QEMU_COMBINED)/$(COMBINED)/$(WIC_PARTITION); \
	echo "Copied run_app_hw_emu.sh"; \
	wic cp --sector-size=512 ./application ./$(QEMU_COMBINED)/$(COMBINED)/$(WIC_PARTITION); \
	echo "Copied host application"; \
	wic cp --sector-size=512 ./vck190.xclbin ./$(QEMU_COMBINED)/$(COMBINED)/$(WIC_PARTITION); \
	echo "Copied xclbin"; \
	if [ -f ./emconfig.json ]; then \
	  wic cp --sector-size=512 ./emconfig.json ./$(QEMU_COMBINED)/$(COMBINED)/$(WIC_PARTITION); \
	  echo "Copied emconfig.json"; \
	else \
	  echo "WARNING: emconfig.json not found, skipping (XRT cosim may not find device)"; \
	fi; \
	if [ -f ./$(ZOCL_DTBO) ]; then \
	  wic cp --sector-size=512 ./$(ZOCL_DTBO) ./$(QEMU_COMBINED)/$(COMBINED)/$(WIC_PARTITION); \
	  echo "Copied zocl device-tree overlay $(ZOCL_DTBO)"; \
	else \
	  echo "WARNING: $(ZOCL_DTBO) not found, skipping (zocl will not bind, XRT will see no device)"; \
	fi'

run_emu:
	@echo "Starting hardware emulation..."
	$(MAKE) build
	$(MAKE) package TARGET=hw_emu
	$(MAKE) emconfig
	$(MAKE) dtbo
	$(MAKE) aiesim_options
	$(MAKE) host
	$(MAKE) qemu_combined
	$(MAKE) copy_bin
	$(MAKE) insert_image TARGET=hw_emu
	$(MAKE) start_emu

start_emu:
	$(ROOT_DIR)/package.hw_emu/launch_hw_emu.sh \
		-qemu-config $(ROOT_DIR)/${QEMU_COMBINED}/${COMBINED}/${COMBINED}.qemuboot.conf \
		-login "amd-edf" -password "amd-edf" \
		-aie-sim-options $(ROOT_DIR)/$(AIESIM_OPTIONS) \
		-run-app "mount /dev/mmcblk0p2 /media; cd /media; ./run_app_hw_emu.sh" | tee embedded_run.log; exit $${PIPESTATUS[0]}

# =============================================================================
# Cleanup Rules
# =============================================================================
clean:
	@echo "Cleaning build artifacts..."
	$(RM) -rf _aie *.xsa tmp binary_container_1 drivers extracted \
		libadf.a mm2s.xo s2mm.xo .ipcache .Xil $(XCLBIN) *.pdi \
		*.log *.summary *.db build_dir.* _x.* *.csv *.isd *.package_summary \
		analyzer_input

ultraclean: clean
	$(RM) package.* -rf *.link_summary *_x *.txt *.json *summary sysroots \
		environment-setup-x86_64-petalinux-linux \
		version-x86_64-petalinux-linux \
		x86_64-qemu-xilinx-nativesdk-standalone-2026.1+release-stable.sh

# =============================================================================
# Help
# =============================================================================
help:
	@echo "Makefile usage:"
	@echo "  make build TARGET=<hw_emu|hw>     Build kernels and link"
	@echo "  make integration TARGET=<hw_emu|hw>  Clean and rebuild all"
	@echo "  make package TARGET=<hw_emu|hw>     Generate XCLBIN and PDI"
	@echo "  make clean                         Clean build and temp files"
	@echo "  make ultraclean                    Clean everything"
	@echo "  make help                          Show this help message"
