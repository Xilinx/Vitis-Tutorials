# =============================================================================
# Project Configuration
# =============================================================================
ROOT_DIR := $(realpath $(dir $(lastword $(MAKEFILE_LIST))))
TARGET ?= hw_emu

# Command used by clean rules below
RMDIR := rm -rf

# =============================================================================
# Toolchain / Sysroot (EDF Gen1 Cortex-A72 SDK)
# =============================================================================
SYSROOT := $(YOCTO_ARTIFACTS)/amd-cortexa72-common_meta-edf-app-sdk/sdk/sysroots/cortexa72-cortexa53-amd-linux/

# =============================================================================
# Platform
# =============================================================================
PLATFORM ?= ${PLATFORM_REPO_PATHS}/vek280_base/vek280_base.xpfm

EMU_PS := QEMU
ifeq ($(TARGET), sw_emu)
EMU_PS := X86
endif

ifeq ($(EMU_PS),X86)
CXX := g++
else
CXX := $(XILINX_VITIS)/gnu/aarch64/lin/aarch64-linux/bin/aarch64-linux-gnu-g++
endif

#Check for EMU_PS
ifeq ($(TARGET), $(filter $(TARGET),hw_emu hw))
ifeq ($(EMU_PS), X86)
$(error For hw_emu and hw, the design has to run on QEMU. Thus, please give EMU_PS=QEMU for these targets.)
endif
endif

# =============================================================================
# QEMU / EDF Packaging Configuration
# =============================================================================
export QEMU_COMBINED := edf_qemu_images
export COMBINED := combined
export WIC_FILE := edf-platform-disk-image-amd-cortexa72-common.rootfs.wic.qemu-sd
export WIC_PARTITION := $(WIC_FILE):2
export WIC_BOOT_PARTITION := $(WIC_FILE):1

# v++ packager emits a BOOT.bin that bundles bootloader + our design's PDI.
# We swap the prebuilt's BOOT-versal-vek280-multidomain.bin with this one so the
# PLM loads our PL/AIE-ML bitstream during boot rather than the generic prebuilt.
VPP_BOOT_BIN     = $(PACKAGE_OUT)/BOOT.bin
BOOT_BIN_BOARD   = $(QEMU_COMBINED)/$(COMBINED)/BOOT-versal-vek280-multidomain.bin

DISK_IMAGES := amd-cortexa72-common_edf-platform-disk-image
QEMU_IMAGES	:= amd-cortexa72-common_vek280_qemu_prebuilt
YOCTO_QEMU_ARTIFACTS :=
EMBEDDED_EXEC_SCRIPT := embedded_exec.sh

# Makefile input options
LINK_OUTPUT := aieml.xsa
XCLBIN := krnl_aieml.xclbin

# Default values for A, B, C matrix sizes
# A:MxK    B:KxN    C:MxN
sizeM ?= 64
sizeK ?= 64
sizeN ?= 64

# Default for A, B and C sub matrices
# 4x16x8
subM ?= 4
subK ?= 16
subN ?= 8

#Default Number of iterations
NIterations ?= 4

# Width of the PLIOs
PLIOW ?= 128
OPT ?= 0

SIZES := sizeM=$(sizeM) sizeK=$(sizeK) sizeN=$(sizeN) subM=$(subM) subK=$(subK) subN=$(subN) NIterations=$(NIterations) PLIOW=$(PLIOW) OPT=$(OPT)
SIZES_D := -DsizeM=$(sizeM) -DsizeK=$(sizeK) -DsizeN=$(sizeN) -DsubM=$(subM) -DsubK=$(subK) -DsubN=$(subN) -DNIterations=$(NIterations) -DPLIOW=$(PLIOW) -DOPTIMIZED_SOURCE=$(OPT)

KERNEL := mm2s_8_128.cpp s2mm_16_128.cpp s2mm_32_128.cpp
KERNEL_XO := mm2s_8_128.xo s2mm_16_128.xo s2mm_32_128.xo

HOST_SRCS := ./src/host.cpp
EXECUTABLE = ./aieml_system

# Run app script
RUN_APP_SCRIPT = run_app_hw_emu.sh
PACKAGE_OUT = ./package.$(TARGET)

RESULT_STRING = TEST PASSED

CONFIG_FILE := system.cfg


# Command-line options
VPP := v++
AIECC := aiecompiler
AIESIM := aiesimulator

AIE_INCLUDE_FLAGS := -include="$(XILINX_VITIS)/aietools/include" -include="./src/" -include="./data" -include="./"
GRAPH    = src/graph.cpp
LIBADF  = libadf$(OPT).a
AIE_CMPL_CMD := v++ --compile --mode aie --platform $(PLATFORM) --include "./src" --aie.workdir ./Work0 ${GRAPH}
AIE_FLAGS +=  --aie.log-level 5
AIE_FLAGS += --aie.Xpreproc "$(SIZES_D)"
AIE_FLAGS += --aie.Xchess "ClassicMatMult:backend.mist2.xargs=+Omodo"
AIE_FLAGS += --aie.output-archive $(LIBADF)

VPP_XO_FLAGS := -c -t $(TARGET) --platform $(PLATFORM) --save-temps -g
VPP_LINK_FLAGS := -l --platform $(PLATFORM) $(KERNEL_XO) $(LIBADF) -t $(TARGET) --save-temps -g --config $(CONFIG_FILE) -o $(LINK_OUTPUT)

GCC_FLAGS := -Wall -c \
			 -std=c++17 \
			 -Wno-int-to-pointer-cast \
			 --sysroot=$(SYSROOT) \

GCC_INCLUDES := -I$(SYSROOT)/usr/include/xrt \
				-I$(SYSROOT)/usr/include \
				-I./ -I./src/ \
				-I${XILINX_VITIS}/aietools/include \
				-I${XILINX_VITIS}/include

GCC_LIB := -Wall -std=c++17 \
		   -L$(SYSROOT)/usr/lib \
		   --sysroot=$(SYSROOT) \
		   -L${XILINX_VITIS}/aietools/lib/aarch64.o \
		   -ladf_api_xrt -lxrt_coreutil -lpthread -lrt -ldl -luuid

ifeq ($(TARGET),$(filter $(TARGET),sw_emu))
ifeq ($(EMU_PS), X86)
       GCC_LIB := -lxrt_coreutil -L${XILINX_VITIS}/aietools/lib/lnx64.o -L${XILINX_XRT}/lib
       GCC_FLAGS := -Wall -c -std=c++17 -Wno-int-to-pointer-cast -I${XILINX_XRT}/include
       GCC_INCLUDES := -I./src/ -I./ -I${XILINX_VITIS}/aietools/include
else
       GCC_LIB := -lxrt_coreutil -L$(SYSROOT)/usr/lib --sysroot=$(SYSROOT) -L${XILINX_VITIS}/aietools/lib/aarch64.o
endif
endif

.PHONY: all clean cleanall docs emconfig dtbo aiesim_options kernels aie build host sd_card run qemu_combined copy_bin insert_image start_emu
all:  kernels aie build host sd_card

# emconfig.json describes the platform/board topology to XRT in emulation mode
# (XCL_EMULATION_MODE=hw_emu). The cosim XRT shim in the guest reads it from
# the host application's working directory; we ship it alongside aieml_system
# in /media (see insert_image).
emconfig: $(LINK_OUTPUT)
	@echo "Generating emconfig.json from $(LINK_OUTPUT)..."
	emconfigutil --platform $(LINK_OUTPUT) --od . --nd 1

# Compile the auto-generated zocl device-tree overlay so it can be applied at
# runtime via fpgautil.  Without this overlay the booted Linux DT has no
# `zyxclmm_drm` (compatible "xlnx,zocl-versal") node, and zocl never registers
# a /dev node -> XRT throws "No such device with index '0'".
DTC ?= $(shell command -v dtc 2>/dev/null || echo $(XILINX_VIVADO)/bin/dtc)
ZOCL_DTSI := _x/package/updated_zocl.dtsi
ZOCL_DTBO := vek280.dtbo
dtbo: $(ZOCL_DTBO)
$(ZOCL_DTBO):
	@if [ ! -f $(ZOCL_DTSI) ]; then \
		echo "WARNING: $(ZOCL_DTSI) not found; cannot generate zocl overlay."; \
		echo "         The host application will hit 'No such device with index 0' at runtime."; \
	else \
		echo "Compiling zocl overlay $(ZOCL_DTSI) -> $@"; \
		( echo '/dts-v1/; /plugin/;'; cat $(ZOCL_DTSI) ) > $@.dts; \
		$(DTC) -@ -O dtb -o $@ -I dts $@.dts; \
		$(RM) $@.dts; \
	fi

# aiesim_options.txt points launch_hw_emu.sh's AIE simulator backend at the
# absolute path of the AIE compiler workdir, which is where xsim looks for the
# graph/CDO/elfs it needs to cosimulate the AIE-ML side.  The AIE-ML sample
# uses --aie.workdir ./Work0 so AIE_PKG_DIR resolves to that directory.
AIESIM_OPTIONS := aiesim_options.txt
AIE_WORKDIR := Work0
aiesim_options: $(AIESIM_OPTIONS)
$(AIESIM_OPTIONS):
	@echo "Writing $(AIESIM_OPTIONS) (points AIE simulator at $(ROOT_DIR)/$(AIE_WORKDIR))"
	@rm -f $@
	@echo "AIE_PKG_DIR=$(ROOT_DIR)/$(AIE_WORKDIR)" > $@

######################################################
# Compiles the HLS C kernels and creates ADF Graph stubs
kernels: $(KERNEL_XO)
	@echo "COMPLETE: Kernels Created."

mm2s_8_128.xo: src/mm2s_8_128.cpp
	$(VPP) $(VPP_XO_FLAGS) -k $(basename $(notdir $<)) $< -o $@
s2mm_16_128.xo: src/s2mm_16_128.cpp
	$(VPP) $(VPP_XO_FLAGS) -k $(basename $(notdir $<)) $< -o $@
s2mm_32_128.xo: src/s2mm_32_128.cpp
	$(VPP) $(VPP_XO_FLAGS) -k $(basename $(notdir $<)) $< -o $@

#########################################################
# Compiles the AIE Graph and emits libadf*.a
aie: ${LIBADF}
${LIBADF}: src/*
	${AIE_CMPL_CMD} ${AIE_FLAGS}
	@echo "COMPLETE: $(LIBADF) created."

########################################################
# Links to build the .xsa
build:  $(LINK_OUTPUT)

$(LINK_OUTPUT): $(KERNEL_XO) $(LIBADF)
	$(VPP) $(VPP_LINK_FLAGS) || (echo "task: [xclbin] failed error code: $$?"; exit 1)
	@echo "COMPLETE: .xsa created"

############################################################################################################################
# Build the host application
host: $(EXECUTABLE)

$(EXECUTABLE): $(HOST_SRCS)
ifneq ($(EMU_PS), X86)
endif
		$(CXX) $(HOST_SRCS) $(GCC_FLAGS) $(GCC_INCLUDES) $(SIZES_D) -o main.o
		$(CXX) *.o $(GCC_LIB) -o $(EXECUTABLE)
	@echo "COMPLETE: Host application created."

##################################################################################################
# Package for the EDF flow.  For hw_emu we use --package.no_image and inject artifacts into the
# rootfs WIC via "wic cp".  For hw we ship the dtbo/pdi/xclbin/app in package.hw/ for the board.
sd_card: $(LINK_OUTPUT) $(XCLBIN)

$(XCLBIN): $(LIBADF) $(KERNEL_XO) $(EXECUTABLE)
ifeq ($(TARGET),$(filter $(TARGET),sw_emu hw_emu))
	v++ -p -t $(TARGET) --save-temps \
		--platform $(PLATFORM) \
		--package.out_dir $(PACKAGE_OUT) \
		--package.defer_aie_run \
		$(LINK_OUTPUT) $(LIBADF) -o $(XCLBIN)
	@echo "COMPLETE: emulation package created."
	$(MAKE) emconfig
	$(MAKE) dtbo
	$(MAKE) aiesim_options
	$(MAKE) qemu_combined
	$(MAKE) copy_bin
	$(MAKE) insert_image TARGET=hw_emu
	$(MAKE) start_emu
else
	v++ -p -t hw --save-temps --platform $(PLATFORM) \
		--package.out_dir $(PACKAGE_OUT) \
		--package.defer_aie_run \
		$(LINK_OUTPUT) $(LIBADF) -o $(XCLBIN)
	$(MAKE) dtbo
	@echo "### ***** sd_card generation done! ***** ###"
	@mkdir -p hw_run/
	@cp -rf $(PACKAGE_OUT)/*.pdi ./$(XCLBIN) $(ZOCL_DTBO) $(EXECUTABLE) $(notdir $(EMBEDDED_EXEC_SCRIPT)) hw_run/
	@echo "Copy hw_run/ to your board and execute $(notdir $(EMBEDDED_EXEC_SCRIPT))"
endif
###################################################################################################

# =============================================================================
# EDF QEMU Helpers
# =============================================================================
qemu_combined:
	@echo "Preparing QEMU combined images..."
	$(RM) -rf ${QEMU_COMBINED}
	@mkdir -p ${QEMU_COMBINED}/${COMBINED}
	@if ls ${YOCTO_ARTIFACTS}/${DISK_IMAGES}/*.wic* >/dev/null 2>&1; then \
		echo "Copying from YOCTO_ARTIFACTS..."; \
		cp -prf ${YOCTO_ARTIFACTS}/${DISK_IMAGES}/* ${QEMU_COMBINED}/${COMBINED}/; \
		cp -prf ${YOCTO_ARTIFACTS}/${QEMU_IMAGES}/* ${QEMU_COMBINED}/${COMBINED}/; \
	elif ls ${YOCTO_QEMU_ARTIFACTS}/*.wic* >/dev/null 2>&1; then \
		echo "Primary source not found, copying from YOCTO_QEMU_ARTIFACTS..."; \
		cp -prf ${YOCTO_QEMU_ARTIFACTS}/* ${QEMU_COMBINED}/${COMBINED}/; \
	else \
		echo "Error: Required WIC files not found in either source directory."; \
		exit 1; \
	fi

# Replace the prebuilt BOOT-versal-vek280-multidomain.bin (which holds only the
# generic bootloader chain) with the BOOT.bin emitted by v++ --package, so the
# PLM boots our design's PDI.  If the packager did not emit BOOT.bin (e.g. due
# to the known 2026.1 lopper/aie_*.dtb tool regression), fall back to the
# prebuilt with a warning so the build can still complete.
copy_bin:
	@if [ -f $(VPP_BOOT_BIN) ]; then \
		echo "Replacing $(BOOT_BIN_BOARD) with locally-built $(VPP_BOOT_BIN)"; \
		$(RM) $(BOOT_BIN_BOARD); \
		cp $(VPP_BOOT_BIN) $(BOOT_BIN_BOARD); \
		echo "Refreshing boot.bin symlink so wic cp + runqemu pick up the new BOOT.bin"; \
		$(RM) $(QEMU_COMBINED)/$(COMBINED)/boot.bin; \
		ln -sf BOOT-versal-vek280-multidomain.bin $(QEMU_COMBINED)/$(COMBINED)/boot.bin; \
	else \
		echo "WARNING: $(VPP_BOOT_BIN) not found; keeping prebuilt $(BOOT_BIN_BOARD)."; \
		echo "         The design PL/AIE-ML PDI will not be loaded during boot."; \
		echo "         This is the expected behaviour while the Vitis 2026.1 lopper"; \
		echo "         tool regression (missing aie_*.dtb -> BOOT.bin) is unresolved."; \
	fi

insert_image:
	@echo "Inserting images into base WIC..."
	@bash -c '\
	unset LD_LIBRARY_PATH; \
	source $(XILINX_VITIS)/data/emulation/qemu/comp/qemu_edf/environment-setup-x86_64-amdedfsdk-linux; \
	echo "Sourced environment"; \
	wic cp --sector-size=512 ./$(QEMU_COMBINED)/$(COMBINED)/boot.bin ./$(QEMU_COMBINED)/$(COMBINED)/$(WIC_BOOT_PARTITION); \
	echo "Copied boot.bin into partition 1 (EFI)"; \
	wic cp --sector-size=512 ./$(RUN_APP_SCRIPT) ./$(QEMU_COMBINED)/$(COMBINED)/$(WIC_PARTITION); \
	echo "Copied $(RUN_APP_SCRIPT)"; \
	wic cp --sector-size=512 $(EXECUTABLE) ./$(QEMU_COMBINED)/$(COMBINED)/$(WIC_PARTITION); \
	echo "Copied host application"; \
	wic cp --sector-size=512 ./$(XCLBIN) ./$(QEMU_COMBINED)/$(COMBINED)/$(WIC_PARTITION); \
	echo "Copied xclbin"; \
	if [ -f ./emconfig.json ]; then \
	  wic cp --sector-size=512 ./emconfig.json ./$(QEMU_COMBINED)/$(COMBINED)/$(WIC_PARTITION); \
	  echo "Copied emconfig.json"; \
	else \
	  echo "WARNING: emconfig.json not found, skipping (XRT cosim may not find device)"; \
	fi; \
	if [ -f ./$(ZOCL_DTBO) ]; then \
	  wic cp --sector-size=512 ./$(ZOCL_DTBO) ./$(QEMU_COMBINED)/$(COMBINED)/$(WIC_PARTITION); \
	  echo "Copied zocl device-tree overlay $(ZOCL_DTBO)"; \
	else \
	  echo "WARNING: $(ZOCL_DTBO) not found, skipping (zocl will not bind, XRT will see no device)"; \
	fi'

start_emu:
	$(ROOT_DIR)/$(PACKAGE_OUT)/launch_hw_emu.sh \
		-qemu-config $(ROOT_DIR)/${QEMU_COMBINED}/${COMBINED}/${COMBINED}.qemuboot.conf \
		-login "amd-edf" -password "amd-edf" \
		-aie-sim-options $(ROOT_DIR)/$(AIESIM_OPTIONS) \
		-run-app "mount /dev/mmcblk0p2 /media; cd /media; ./$(RUN_APP_SCRIPT)" | tee embedded_run.log; exit $${PIPESTATUS[0]}

############################## Cleaning Rules ##############################
clean:
	-$(RMDIR) $(EXECUTABLE) $(XCLBIN)/{*sw_emu*,*hw_emu*}
	-$(RMDIR) profile_* TempConfig system_estimate.xtxt *.rpt *.csv *.o *.xo *.xpe *.xsa cfg qemu_dts_files emu_qemu_scripts *.db sim *.sh *.a
	-$(RMDIR) /src/sw/*.ll /src/pl_kernels/*.ll src/aie/*.ll *v++* .Xil emconfig.json dltmp* xmltmp* *.log *.jou *.wcfg *.wdb *bin* *summary* *.BIN *.bif *.exe Work *.log *.txt

cleanall: clean
	-$(RMDIR) build_dir* sd_card*
	-$(RMDIR) package.* run_app.sh
	-$(RMDIR) _x* *xclbin.run_summary qemu-memory-_* emulation _vimage start_simulation.sh *.xclbin
